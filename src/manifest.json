{
  "manifest_version": 3,
  "name": "Page to Markdown",
  "version": "1.2.0",
  "description": "Convert the current page into clean, editable Markdown.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "windows"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Page to Markdown",
    "default_popup": "popup.html"
  }
}
